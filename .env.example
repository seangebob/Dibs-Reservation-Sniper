# Backend environment template. Copy to .env and fill in; .env is gitignored.
#
# Nothing reads this file automatically -- load it into each terminal that runs
# the API or the worker:
#
#   set -a; source .env; set +a          # macOS / Linux
#
# Every variable is optional. Commented-out lines show the default. The full
# reference, with bounds, is docs/ARCHITECTURE.md#configuration.

# --- Language model (prompt parsing) ---
# Prompts are read by a free local model through Ollama (or LM Studio,
# llama.cpp, vLLM); no key needed. Download the model first:
#   ollama pull qwen3.5:9b
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=qwen3.5:9b

# Optional: read prompts with OpenAI instead. LLM_PROVIDER must name it; a key
# on its own does nothing.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Locale ---
# RESERVATION_TIMEZONE=America/Toronto

# --- Reservation provider ---
# Where availability and bookings come from. Only the simulation exists so far.
# RESERVATION_PROVIDER=mock

# --- Redis: durable watches + the Celery broker ---
# Unreachable => in-memory store and in-process polling.
# REDIS_URL=redis://localhost:6379/0

# --- PostgreSQL: accounts, the /watches dashboard, email recipients ---
# Matches infra/docker-compose.yml. The worker needs this too.
# POSTGRES_URL=postgresql://dibs:dibs@localhost:5432/dibs

# --- Sign-in cookie ---
# Secure flag on the session cookie: auto (when the request came over https),
# true, or false. Use true in production.
# SESSION_COOKIE_SECURE=auto

# --- Browser access ---
# Needed when the browser calls the API directly (Docker, a deployment, or
# NEXT_PUBLIC_API_BASE_URL set). `npm run dev` forwards /api itself and doesn't
# need it. Unset => the API sends no CORS headers.
# FRONTEND_ORIGINS=http://localhost:3000

# --- Email (unset SMTP_HOST => notifications are only logged) ---
# Set these for both the API and the worker.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_FROM=dibs@example.com
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# DASHBOARD_BASE_URL=http://localhost:3000

# --- Watch pacing ---
# Base seconds between checks for one watch (15-3600), jittered by +/- the
# jitter (must be smaller than the interval).
# WATCH_POLL_INTERVAL_SECONDS=180
# WATCH_POLL_JITTER_SECONDS=30
# Safety ceiling on checks per watch. Each watch derives its own budget from
# its remaining lifetime and is capped here; a low value makes far-off watches
# stop before their date.
# WATCH_MAX_POLL_ATTEMPTS=25000

# --- Running behind a proxy ---
# Proxies whose X-Forwarded-For uvicorn trusts for the client address. Rate
# limits key on that address. "*" only if the app is reachable solely via the proxy.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
