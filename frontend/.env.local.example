# Base URL of the Dibs FastAPI backend, for a backend that isn't the local one.
#
# Leave it unset for local development: `npm run dev` then forwards /api/* to
# http://localhost:8000, and the backend needs no CORS setup.
#
# When set, the browser calls this URL directly, so it must be reachable from
# the visitor's machine (not a docker-internal host), and that backend needs
# FRONTEND_ORIGINS to include this site's origin. Copy this file to
# `.env.local` to use it.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
